# ---------------------------------------------------------------------------
# MURRAY PTS v2 configuration
#
# Copy to `.env` next to the repository root (or next to the launcher's working directory)
# and edit. `.env` is gitignored and is read once at startup; every value can also be
# supplied as a real OS environment variable or a JVM system property (-Dpts.port=9000).
# Precedence: system property > OS env var > .env > the default shown here.
#
# NEVER commit a filled-in .env: PTS_SESSION_SECRET and PTS_ADMIN_PASSWORD are credentials.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Port and interface to listen on. Behind a reverse proxy, bind to loopback only.
# The app does not know its own domain name: murraypts.mn lives in DNS (or, on a single PC, in that
# machine's hosts file via deploy/use-local-name.ps1), so here you only choose where the process
# listens. 0.0.0.0 means "any interface", which is only
# acceptable with a proxy you control in front; on a VPS prefer PTS_HOST=127.0.0.1, and on a PC that
# should serve only itself 127.0.0.1 also means a colleague's http://<this pc>:8080 will not connect.
PTS_PORT=8080
PTS_HOST=0.0.0.0

# development (default) | production. Production refuses to boot with the built-in
# session secret, adds the Strict-Transport-Security header, and defaults
# PTS_SECURE_COOKIES to true.
PTS_ENV=development

# Read X-Forwarded-For/-Host/-Proto from a reverse proxy. Leave false unless a proxy you
# control is the only way in: on a publicly reachable port these headers are attacker
# supplied, and trusting them would let anyone dodge the login rate limiter by changing them.
PTS_TRUST_PROXY=false

# --- Persistence -----------------------------------------------------------
# SQLite database file. Parent directories are created automatically.
PTS_DB_PATH=data/pts.db
# Directory the data dir lives in (backup scripts, docker volumes).
PTS_DATA_DIR=data
# Legacy v1 JSON store. Imported into SQLite ONCE, only when the database is empty, and then
# renamed to pts-data.json.migrated-<timestamp>. Point at a file that does not exist to skip.
PTS_DATA_FILE=data/pts-data.json
# Seed the demo dataset into an EMPTY database (never into one that has users, and never when
# a legacy JSON file is waiting to be imported). Keep false in production.
PTS_SEED_DEMO=false

# --- Security --------------------------------------------------------------
# HMAC key for CSRF tokens. Generate one per environment:
#   openssl rand -hex 32
# Required in production; must be at least 32 characters there.
PTS_SESSION_SECRET=
PTS_SESSION_COOKIE=PTS_SID
# Session lifetime in hours. Counted from login, not from the last click — an active user is
# still logged out when the session reaches this age.
PTS_SESSION_TTL_HOURS=12
# Mark the session cookie Secure (HTTPS only). Defaults to true when PTS_ENV=production.
# If you test production settings over plain http://, set this to false or login will loop.
# PTS_SECURE_COOKIES=false

# --- Admin bootstrap -------------------------------------------------------
# Employee number ensured on every boot, as super admin.
PTS_ADMIN_EMPNO=EMP0000
# Optional initial password for that admin on a FRESH database. If unset, the password falls
# back to the employee number and the account is flagged "must change password", so the first
# login lands on Settings and cannot go anywhere else until a new password is set.
# PTS_ADMIN_PASSWORD=

# --- Login rate limiting ---------------------------------------------------
# Failed attempts allowed per client IP within the window (the IP comes from the proxy only
# when PTS_TRUST_PROXY=true).
PTS_LOGIN_MAX_ATTEMPTS=5
PTS_LOGIN_WINDOW_SECONDS=60

# --- Logging ---------------------------------------------------------------
# One INFO line per request. Off by default so local output is unchanged; production
# normally turns it on (the log file is the audit trail).
PTS_LOG_REQUESTS=false

# IMPORTANT: these two are read by Logback, which configures itself before .env is parsed.
# Set them as real environment variables or in deploy/run.bat / run.sh / docker-compose.yml —
# a .env entry here changes nothing.
# PTS_LOG_DIR=logs
# PTS_LOG_LEVEL=INFO   # TRACE DEBUG INFO WARN ERROR

# --- Due-date alerts -------------------------------------------------------
# A daily sweep mails the people responsible for any project or task that is unfinished and whose
# due date is within PTS_ALERT_LEAD_DAYS (or already past). Recipients come from the data: the
# project's assigned manager plus its assignees, and for a task its assignee plus its project's
# manager. Addresses are the `users.email` values maintained in Access control.
PTS_ALERTS_ENABLED=true
# Days before the due date the first reminder goes out. An unfinished item then repeats once a day
# until it is Completed (or, for a project, reaches 100%), switching to overdue wording after the date.
PTS_ALERT_LEAD_DAYS=7
# Sweep interval in hours, and the delay after boot before the first one.
PTS_ALERT_INTERVAL_HOURS=24
PTS_ALERT_STARTUP_DELAY_SECONDS=30
# Days of alert history to keep in the due_date_alerts ledger (0 = keep everything).
PTS_ALERT_LEDGER_KEEP_DAYS=90

# --- Outbound mail (SMTP) --------------------------------------------------
# With no host the sweep still runs: every message is rendered, logged, and written to the ledger
# with delivered=0, and boot says so ("Launch check: due-date alerts are enabled but
# PTS_SMTP_HOST is empty"). That is the mode to rehearse rules in before there is a mail server.
# murrays.mn is a Microsoft 365 domain: README → "Sending through Microsoft 365" has the exact values
# (smtp.office365.com:587, starttls) and the two admin-centre prerequisites — the mailbox must exist,
# and Authenticated SMTP must be switched on for it, because this mailer speaks plain LOGIN only.
PTS_SMTP_HOST=
PTS_SMTP_PORT=587
# starttls (plain connect, then upgrade; port 587) | ssl (implicit TLS; port 465) | none.
# "none" is only acceptable on a loopback relay you control.
PTS_SMTP_SECURITY=starttls
PTS_SMTP_USERNAME=
# Leave this file's value blank and paste the real password into the host's .env — it must not be
# committed. Boot prints a "Launch check:" advisory if PTS_SMTP_HOST is set while this is empty.
# PTS_SMTP_PASSWORD=
# Envelope sender; defaults to PTS_SMTP_USERNAME when empty. Sending fails with neither set.
PTS_SMTP_FROM=
# Render and ledger the messages but never open a connection — the safe way to test a rule change.
PTS_SMTP_DRY_RUN=false

# --- Alert endpoints (Admin only, plain text) ------------------------------
#   POST /app/alerts/run      sweep now and print the report
#   GET  /app/alerts/recent   read recent ledger rows (?limit=50)
#   POST /app/alerts/test     send one test mail (?to=…, defaults to the signed-in admin's own
#                             address). Bypasses the ledger, so it cannot spend anyone's daily alert.
# All three are session-bound and require the Admin role; see the README "Due-date alerts" section.
